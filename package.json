{
  "name": "anjam",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/i18n-parity.mjs && node --experimental-strip-types scripts/unit.mjs && node --experimental-strip-types scripts/timezone-check.mjs && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-capacitor-mirrors.js",
    "desktop": "npm run build && electron .",
    "release:win": "npm run build && electron-builder --win",
    "test": "node scripts/i18n-parity.mjs && node --experimental-strip-types scripts/unit.mjs && node --experimental-strip-types scripts/timezone-check.mjs",
    "qa": "node scripts/cdp-ux-check.mjs",
    "probe": "node scripts/probe-bugs.mjs"
  },
  "dependencies": {
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/status-bar": "^6.0.3",
    "@supabase/supabase-js": "^2.45.4",
    "jalaali-js": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
